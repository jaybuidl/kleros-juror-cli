{
  "name": "kleros-juror-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless CLI for committing and revealing Kleros v2 juror votes on Arbitrum One",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaybuidl/kleros-juror-cli.git"
  },
  "homepage": "https://github.com/jaybuidl/kleros-juror-cli#readme",
  "bugs": "https://github.com/jaybuidl/kleros-juror-cli/issues",
  "keywords": [
    "kleros",
    "arbitration",
    "juror",
    "dispute-resolution",
    "commit-reveal",
    "arbitrum",
    "ethereum",
    "cli",
    "agent"
  ],
  "bin": {
    "kleros-juror": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills/kleros-juror/SKILL.md",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "test:fork": "anvil --fork-url ${ARBITRUM_RPC:-https://arb1.arbitrum.io/rpc} --port 8546 --silent & ANVIL=$!; sleep 6; vitest run src/__tests__/fork.test.ts; STATUS=$?; kill $ANVIL; exit $STATUS",
    "test:acceptance": "KLEROS_ARCHIVE_RPC=${KLEROS_ARCHIVE_RPC:-$(mesc url arbitrum_alchemy 2>/dev/null)} vitest run src/__tests__/acceptance.fork.test.ts"
  },
  "dependencies": {
    "incur": "~0.4.19",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@kleros/kleros-v2-contracts": "^2.0.0-rc.2",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@arbitrum/nitro-contracts"
    ]
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
